# BIXNOII Supabase client configuration
# Copy this file to .env.local for local development.
#
# These two values are required by the current app.
# The publishable key is designed to be used by browser/client apps.
# Do NOT put a service_role key or sb_secret_* key in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# No Supabase secret/service-role key is required by the current BIXNOII app.
# Authentication and data access use the signed-in user's session + RLS.
